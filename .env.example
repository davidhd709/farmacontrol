# ==============================================================================
# Sistema de Gestión para Farmacia — Entorno de Desarrollo Local
# ==============================================================================
# Copie este archivo a .env para personalizar sus variables locales.
# NUNCA almacene credenciales reales ni suba .env al repositorio Git.

NODE_ENV=development

# Configuración de PostgreSQL local (Docker Compose)
DB_USER=farmacia_user
DB_PASSWORD=farmacia_dev_password_change_me
DB_NAME=farmacia_db
DB_TEST_NAME=farmacia_test
# Puerto 5434 en el host para evitar colisiones con instancias existentes en 5432 o 5433
DB_PORT=5434

# Cadena de conexión para acceso a base de datos en desarrollo
DATABASE_URL=postgresql://farmacia_user:farmacia_dev_password_change_me@localhost:5434/farmacia_db?schema=public

# Cadena de conexión exclusiva para pruebas automatizadas (aislada de desarrollo)
DATABASE_TEST_URL=postgresql://farmacia_user:farmacia_dev_password_change_me@localhost:5434/farmacia_test?schema=public

# Configuración de API
API_PORT=3000
API_PREFIX=/api/v1
SESSION_SECRET=dev_session_secret_at_least_32_characters_long_for_security

# Configuración de Web
VITE_API_URL=http://localhost:3000/api/v1
