# ==============================================================================
# FarmaControl — Variables de Entorno para Producción (.env)
# IMPORTANTE: Copiar este archivo a infra/compose/.env en el servidor.
# NUNCA versionar el archivo .env definitivo con secretos reales en Git.
# ==============================================================================

# Dominio público y terminación TLS automática en Caddy
DOMAIN=farmacontrol.tachetech.com

# Lista blanca de orígenes CORS permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=https://farmacontrol.tachetech.com

# Base de datos PostgreSQL
DB_USER=farmacontrol
DB_PASSWORD=replace_with_a_secure_random_db_password
DB_NAME=farmacontrol

# Clave secreta para tokens y sesiones opacas (mínimo 32 caracteres criptográficos)
SESSION_SECRET=replace_with_a_random_32_byte_or_longer_secret

# Puerto interno de la API
API_PORT=3000

# Política de retención de respaldos periódicos (días)
RETENTION_DAYS=30
