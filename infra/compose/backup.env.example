# ==============================================================================
# FarmaControl — Copia de respaldo fuera del servidor (AUD-013)
# Copiar a infra/compose/backup.env en el servidor. NUNCA versionar backup.env.
# ==============================================================================

# Clave PÚBLICA age (age1...). El servidor solo cifra; la clave privada se guarda fuera del
# servidor (gestor de contraseñas + copia impresa o USB). Generar en un equipo seguro con:
#   age-keygen -o farmacontrol-backup.key   # imprime la clave pública
BACKUP_AGE_RECIPIENT=age1replace_with_the_public_key

# Destino de rclone: <nombre_remoto>:<bucket o carpeta>. El remoto se define abajo con
# variables RCLONE_CONFIG_<NOMBRE>_*. Debe estar en otro proveedor o equipo distinto del servidor.
BACKUP_REMOTE=offsite:farmacontrol-backups
REMOTE_RETENTION_DAYS=90

# Hora local del respaldo diario (TZ del contenedor: America/Bogota)
BACKUP_TIME=02:00

# Ejemplo con almacenamiento compatible con S3 (Cloudflare R2, Backblaze B2, AWS S3...).
# Usar credenciales con permiso solo sobre este bucket.
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=Cloudflare
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=replace_me
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=replace_me
RCLONE_CONFIG_OFFSITE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
RCLONE_CONFIG_OFFSITE_NO_CHECK_BUCKET=true

# Alternativa: otro servidor por SFTP
# RCLONE_CONFIG_OFFSITE_TYPE=sftp
# RCLONE_CONFIG_OFFSITE_HOST=backup.example.com
# RCLONE_CONFIG_OFFSITE_USER=farmacontrol
# RCLONE_CONFIG_OFFSITE_KEY_FILE=/run/secrets/backup_ssh_key
