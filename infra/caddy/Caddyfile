{
	# Opciones globales de Caddy
	# admin off deshabilita la API de administración local si no es requerida
	admin off
}

{$DOMAIN:localhost} {
	# Compresión moderna para optimizar ancho de banda
	encode zstd gzip

	# Registro estructurado en JSON para observabilidad e ingestión de logs
	log {
		output stdout
		format json
		level INFO
	}

	# Cabeceras comunes a la SPA y a la API. La API añade además su propia CSP.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Enrutamiento prioritario hacia la API REST
	handle /api/* {
		# Importación de Excel y demás cargas: mismo tope que tenía el proxy anterior
		request_body {
			max_size 10MB
		}
		reverse_proxy api:3000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			# Se reemplaza, no se concatena: el cliente no puede inyectar su propia IP
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Enrutamiento hacia la SPA Web (Nginx estático)
	handle {
		header {
			# Sin scripts inline ni externos; MUI/emotion necesita estilos inline.
			# blob: cubre las descargas de reportes generadas en el navegador.
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
			X-Frame-Options "DENY"
			Cross-Origin-Opener-Policy "same-origin"
			Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		}
		reverse_proxy web:80 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}
