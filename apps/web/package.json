{
  "name": "@farmacia/web",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicación web cliente en React + Vite para el Sistema de Gestión de Farmacia",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint src/",
