{
  "name": "@farmacia/api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST principal para el Sistema de Gestión de Farmacia (NestJS)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:admin": "tsx src/modules/identity/infrastructure/cli/provision-initial-user.ts"
  },
  "dependencies": {
    "@farmacia/contracts": "workspace:*",
    "@farmacia/database": "workspace:*",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-express": "^11.0.11",
    "argon2": "^0.45.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.2.5",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.2.7"
  }
}
