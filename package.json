{
  "name": "farmacia-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de Gestión para Farmacia — Monolito Modular",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run",
    "db:up": "docker compose -f infra/compose/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/compose/docker-compose.yml down",
    "db:status": "docker compose -f infra/compose/docker-compose.yml ps",
    "db:validate": "pnpm --filter @farmacia/database db:validate",
    "db:generate": "pnpm --filter @farmacia/database db:generate",
    "db:check": "pnpm --filter @farmacia/database db:check",
    "db:test:create": "./infra/scripts/create-test-db.sh",
    "db:test:check": "pnpm --filter @farmacia/database db:test:check",
    "db:test:migrate": "pnpm --filter @farmacia/database db:test:migrate",
    "db:seed:rbac": "pnpm --filter @farmacia/database db:seed:rbac",
    "db:seed:admin": "pnpm --filter @farmacia/api seed:admin",
    "db:seed:puc": "pnpm --filter @farmacia/database db:seed:puc",
    "db:reset:admin-password": "pnpm --filter @farmacia/api reset:admin-password"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.2.7"
  }
}
