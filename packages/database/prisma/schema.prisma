datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique @db.VarChar(50)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  sessions              Session[]
  userRoles             UserRole[]
  auditEvents           AuditEvent[]
  inventoryMovements    InventoryMovement[]
  purchasesReceived     Purchase[]
  cashMovements         CashMovement[]
  salesCreated          Sale[]              @relation("SalesCreated")
  idempotencyKeys       IdempotencyKey[]    @relation("UserIdempotencyKeys")
  receivablePayments    ReceivablePayment[]
  payablePayments       PayablePayment[]
  accountingMappingsUpdated CompanyAccountingMapping[] @relation("AccountingMappingsUpdated")
  journalEntriesCreated JournalEntry[] @relation("JournalEntriesCreated")
  taxProfilesActivated ProductTaxProfile[] @relation("ProductTaxProfilesActivated")
  bankAccountsCreated   BankAccount[]       @relation("UserBankAccounts")
  bankMovementsCreated  BankMovement[]      @relation("UserBankMovements")
  expensesCreated       Expense[]           @relation("ExpensesCreated")
  expensesCancelled     Expense[]           @relation("ExpensesCancelled")
  expensePaymentsCreated ExpensePayment[]   @relation("ExpensePaymentsCreated")
  expensePaymentsReversed ExpensePayment[]  @relation("ExpensePaymentsReversed")
  fiscalPeriodsClosed   FiscalPeriod[]      @relation("FiscalPeriodsClosed")
  fiscalPeriodsReopened FiscalPeriod[]      @relation("FiscalPeriodsReopened")
  creditNotesCreated    CreditNote[]        @relation("CreditNotesCreated")
  debitNotesCreated     DebitNote[]         @relation("DebitNotesCreated")

  @@map("users")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique @db.VarChar(50)
  description     String?          @db.VarChar(255)
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique @db.VarChar(100)
  description     String?          @db.VarChar(255)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  assignedAt   DateTime   @default(now()) @map("assigned_at") @db.Timestamptz

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditEvent {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String?   @map("user_id") @db.Uuid
  action        String    @db.VarChar(100)
  entity        String    @db.VarChar(100)
  entityId      String?   @map("entity_id") @db.VarChar(255)
  details       Json?     @db.JsonB
  ipAddress     String?   @map("ip_address") @db.VarChar(45)
  correlationId String?   @map("correlation_id") @db.VarChar(100)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user          User?     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
  @@index([correlationId])
  @@map("audit_events")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(100)
  description String?   @db.VarChar(255)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  products    Product[]

  @@map("categories")
}

model UnitOfMeasure {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(20)
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  category    String   @default("GENERAL") @db.VarChar(30)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  presentations ProductPresentation[]

  @@map("units_of_measure")
}

model Product {
  id                   String   @id @default(uuid()) @db.Uuid
  categoryId           String   @map("category_id") @db.Uuid
  code                 String   @unique @db.VarChar(50)
  barcode              String?  @unique @db.VarChar(50)
  name                 String   @db.VarChar(150)
  genericName          String?  @map("generic_name") @db.VarChar(150)
  concentration        String?  @db.VarChar(50)
  sanitaryRegistry     String?  @map("sanitary_registry") @db.VarChar(50)
  manufacturer         String?  @db.VarChar(100)
  description          String?  @db.VarChar(500)
  requiresLotControl   Boolean  @default(true) @map("requires_lot_control")
  prescriptionRequired Boolean  @default(false) @map("prescription_required")
  baseUnit             String   @default("UNIDAD") @map("base_unit") @db.VarChar(30)
  basePrice            Decimal  @map("base_price") @db.Decimal(12, 2)
  baseCost             Decimal  @default(0) @map("base_cost") @db.Decimal(12, 2)
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  category             Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  presentations        ProductPresentation[]
  lots                 InventoryLot[]
  movements            InventoryMovement[]
  purchaseLines        PurchaseLine[]
  saleLines            SaleLine[]
  alerts               InventoryAlert[]
  taxProfiles          ProductTaxProfile[]
  creditNoteLines      CreditNoteLine[]
  debitNoteLines       DebitNoteLine[]

  @@index([categoryId])
  @@index([name])
  @@index([genericName])
  @@index([isActive])
  @@map("products")
}

model ProductPresentation {
  id                      String                @id @default(uuid()) @db.Uuid
  productId               String                @map("product_id") @db.Uuid
  unitOfMeasureId         String?               @map("unit_of_measure_id") @db.Uuid
  containedPresentationId String?               @map("contained_presentation_id") @db.Uuid
  name                    String                @db.VarChar(100)
  barcode                 String?               @unique @db.VarChar(50)
  quantityContained       Int                   @default(1) @map("quantity_contained")
  conversionFactor        Int                   @map("conversion_factor")
  price                   Decimal               @map("price") @db.Decimal(12, 2)
  cost                    Decimal               @default(0) @map("cost") @db.Decimal(12, 2)
  purchaseEnabled         Boolean               @default(true) @map("purchase_enabled")
  saleEnabled             Boolean               @default(true) @map("sale_enabled")
  isDefault               Boolean               @default(false) @map("is_default")
  isDefaultPurchase       Boolean               @default(false) @map("is_default_purchase")
  isDefaultSale           Boolean               @default(false) @map("is_default_sale")
  isActive                Boolean               @default(true) @map("is_active")
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  product                 Product               @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  unitOfMeasure           UnitOfMeasure?        @relation(fields: [unitOfMeasureId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  containedPresentation   ProductPresentation?  @relation("PresentationHierarchy", fields: [containedPresentationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parentPresentations     ProductPresentation[] @relation("PresentationHierarchy")
  movements               InventoryMovement[]
  purchaseLines           PurchaseLine[]
  saleLines               SaleLine[]

  @@unique([productId, name])
  @@index([productId])
  @@index([productId, isActive])
  @@index([unitOfMeasureId])
  @@index([containedPresentationId])
  @@index([barcode])
  @@map("product_presentations")
}

model Location {
  id          String              @id @default(uuid()) @db.Uuid
  code        String              @unique @db.VarChar(50)
  name        String              @db.VarChar(100)
  description String?             @db.VarChar(255)
  isDefault   Boolean             @default(false) @map("is_default")
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  lots        InventoryLot[]

  @@map("locations")
}

model InventoryLot {
  id              String              @id @default(uuid()) @db.Uuid
  productId       String              @map("product_id") @db.Uuid
  locationId      String              @map("location_id") @db.Uuid
  lotNumber       String              @map("lot_number") @db.VarChar(100)
  expirationDate  DateTime            @map("expiration_date") @db.Date
  currentQuantity Int                 @default(0) @map("current_quantity")
  isActive        Boolean             @default(true) @map("is_active")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  product         Product             @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  location        Location            @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  movements       InventoryMovement[]
  purchaseLines   PurchaseLine[]
  saleAllocations SaleLotAllocation[]
  alerts          InventoryAlert[]
  creditNoteLines CreditNoteLine[]
  debitNoteLines  DebitNoteLine[]

  @@unique([productId, locationId, lotNumber])
  @@index([productId])
  @@index([locationId])
  @@index([productId, expirationDate, currentQuantity])
  @@index([expirationDate])
  @@map("inventory_lots")
}

model InventoryMovement {
  id                          String               @id @default(uuid()) @db.Uuid
  movementType                String               @map("movement_type") @db.VarChar(50)
  productId                   String               @map("product_id") @db.Uuid
  lotId                       String               @map("lot_id") @db.Uuid
  presentationId              String?              @map("presentation_id") @db.Uuid
  quantityBaseUnits           Int                  @map("quantity_base_units")
  presentationFactorHistorical Int                 @default(1) @map("presentation_factor_historical")
  quantityCommercial          Decimal?             @map("quantity_commercial") @db.Decimal(12, 4)
  balanceAfterBaseUnits       Int                  @map("balance_after_base_units")
  referenceDocumentType       String?              @map("reference_document_type") @db.VarChar(50)
  referenceDocumentId         String?              @map("reference_document_id") @db.VarChar(100)
  notes                       String?              @db.VarChar(500)
  createdByUserId             String?              @map("created_by_user_id") @db.Uuid
  createdAt                   DateTime             @default(now()) @map("created_at") @db.Timestamptz

  product                     Product              @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lot                         InventoryLot         @relation(fields: [lotId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  presentation                ProductPresentation? @relation(fields: [presentationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user                        User?                @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([productId])
  @@index([lotId])
  @@index([movementType])
  @@index([createdAt])
  @@index([referenceDocumentType, referenceDocumentId])
  @@map("inventory_movements")
}

model Supplier {
  id          String         @id @default(uuid()) @db.Uuid
  taxId       String         @unique @map("tax_id") @db.VarChar(50)
  name        String         @db.VarChar(150)
  contactName String?        @map("contact_name") @db.VarChar(100)
  phone       String?        @db.VarChar(50)
  email       String?        @db.VarChar(100)
  address     String?        @db.VarChar(255)
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  purchases   Purchase[]
  payables    Payable[]
  debitNotes  DebitNote[]
  thirdParty  ThirdParty?

  @@index([taxId])
  @@index([name])
  @@index([isActive])
  @@map("suppliers")
}

model Purchase {
  id               String         @id @default(uuid()) @db.Uuid
  supplierId       String         @map("supplier_id") @db.Uuid
  invoiceNumber    String         @map("invoice_number") @db.VarChar(100)
  purchaseDate     DateTime       @map("purchase_date") @db.Date
  totalAmount      Decimal        @map("total_amount") @db.Decimal(12, 2)
  status           String         @default("RECEIVED") @db.VarChar(50)
  notes            String?        @db.VarChar(500)
  receivedByUserId String?        @map("received_by_user_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  supplier         Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  receivedByUser   User?          @relation(fields: [receivedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lines            PurchaseLine[]
  payable          Payable?
  debitNotes       DebitNote[]

  @@index([supplierId])
  @@index([invoiceNumber])
  @@index([purchaseDate])
  @@index([status])
  @@map("purchases")
}

model PurchaseLine {
  id                 String               @id @default(uuid()) @db.Uuid
  purchaseId         String               @map("purchase_id") @db.Uuid
  productId          String               @map("product_id") @db.Uuid
  presentationId     String?              @map("presentation_id") @db.Uuid
  lotId              String               @map("lot_id") @db.Uuid
  quantityCommercial           Decimal              @map("quantity_commercial") @db.Decimal(12, 4)
  presentationFactorHistorical Int                  @default(1) @map("presentation_factor_historical")
  quantityBaseUnits            Int                  @map("quantity_base_units")
  unitCost           Decimal              @map("unit_cost") @db.Decimal(12, 2)
  subtotal           Decimal              @map("subtotal") @db.Decimal(12, 2)
  lotNumber          String               @map("lot_number") @db.VarChar(100)
  expirationDate     DateTime             @map("expiration_date") @db.Date
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz

  purchase           Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product            Product              @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  presentation       ProductPresentation? @relation(fields: [presentationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lot                InventoryLot         @relation(fields: [lotId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  debitNoteLines     DebitNoteLine[]

  @@index([purchaseId])
  @@index([productId])
  @@index([lotId])
  @@map("purchase_lines")
}

model CashMovement {
  id                    String   @id @default(uuid()) @db.Uuid
  movementType          String   @map("movement_type") @db.VarChar(50)
  amount                Decimal  @map("amount") @db.Decimal(12, 2)
  paymentMethod         String   @default("EFECTIVO") @map("payment_method") @db.VarChar(50)
  reason                String   @db.VarChar(255)
  referenceDocumentType String?  @map("reference_document_type") @db.VarChar(50)
  referenceDocumentId   String?  @map("reference_document_id") @db.VarChar(100)
  balanceAfter          Decimal  @map("balance_after") @db.Decimal(12, 2)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId       String   @map("created_by_user_id") @db.Uuid

  createdByUser         User     @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([movementType])
  @@index([paymentMethod])
  @@index([createdAt])
  @@index([createdByUserId])
  @@map("cash_movements")
}

model Customer {
  id             String   @id @default(uuid()) @db.Uuid
  documentType   String   @default("CC") @map("document_type") @db.VarChar(20)
  documentNumber String   @unique @map("document_number") @db.VarChar(50)
  name           String   @db.VarChar(150)
  phone          String?  @db.VarChar(50)
  email          String?  @db.VarChar(100)
  address        String?  @db.VarChar(200)
  isDefault      Boolean  @default(false) @map("is_default")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sales          Sale[]
  receivables    Receivable[]
  creditNotes    CreditNote[]
  thirdParty     ThirdParty?

  @@index([documentNumber])
  @@index([name])
  @@index([isActive])
  @@index([isDefault])
  @@map("customers")
}

model Sale {
  id            String   @id @default(uuid()) @db.Uuid
  invoiceNumber String   @unique @map("invoice_number") @db.VarChar(50)
  customerId    String   @map("customer_id") @db.Uuid
  status        String   @default("COMPLETED") @db.VarChar(20)
  paymentMethod String   @default("EFECTIVO") @map("payment_method") @db.VarChar(50)
  bankAccountId String?  @map("bank_account_id") @db.Uuid
  subtotal      Decimal  @db.Decimal(12, 2)
  taxTotal      Decimal  @default(0) @map("tax_total") @db.Decimal(12, 2)
  discountTotal Decimal  @default(0) @map("discount_total") @db.Decimal(12, 2)
  total         Decimal  @db.Decimal(12, 2)
  amountPaid    Decimal  @default(0) @map("amount_paid") @db.Decimal(12, 2)
  changeGiven   Decimal  @default(0) @map("change_given") @db.Decimal(12, 2)
  notes         String?  @db.VarChar(500)
  createdById   String   @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  customer       Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByUser  User                @relation("SalesCreated", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bankAccount    BankAccount?        @relation(fields: [bankAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lines          SaleLine[]
  lotAllocations SaleLotAllocation[]
  receivable     Receivable?
  creditNotes    CreditNote[]

  @@index([invoiceNumber])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([createdById])
  @@index([bankAccountId])
  @@map("sales")
}

model SaleLine {
  id                           String   @id @default(uuid()) @db.Uuid
  saleId                       String   @map("sale_id") @db.Uuid
  productId                    String   @map("product_id") @db.Uuid
  presentationId               String?  @map("presentation_id") @db.Uuid
  presentationFactorHistorical Int      @default(1) @map("presentation_factor_historical")
  quantityCommercial           Decimal  @default(1) @map("quantity_commercial") @db.Decimal(10, 2)
  quantityBaseUnits            Int      @map("quantity_base_units")
  unitPrice                    Decimal  @map("unit_price") @db.Decimal(12, 2)
  discount                     Decimal  @default(0) @db.Decimal(12, 2)
  subtotal                     Decimal  @db.Decimal(12, 2)
  taxRate                      Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount                    Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total                        Decimal  @db.Decimal(12, 2)
  /// Costo por unidad base al confirmar la venta; NULL en ventas anteriores a su registro
  unitCostBase                 Decimal? @map("unit_cost_base") @db.Decimal(12, 2)
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz

  sale           Sale                @relation(fields: [saleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product        Product             @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  presentation   ProductPresentation? @relation(fields: [presentationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lotAllocations SaleLotAllocation[]
  creditNoteLines CreditNoteLine[]

  @@index([saleId])
  @@index([productId])
  @@index([presentationId])
  @@map("sale_lines")
}

model SaleLotAllocation {
  id                String   @id @default(uuid()) @db.Uuid
  saleId            String   @map("sale_id") @db.Uuid
  saleLineId        String   @map("sale_line_id") @db.Uuid
  lotId             String   @map("lot_id") @db.Uuid
  quantityBaseUnits Int      @map("quantity_base_units")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  sale     Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  saleLine SaleLine     @relation(fields: [saleLineId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  lot      InventoryLot @relation(fields: [lotId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([saleId])
  @@index([saleLineId])
  @@index([lotId])
  @@map("sale_lot_allocations")
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  key            String   @unique @db.VarChar(100)
  userId         String   @map("user_id") @db.Uuid
  endpoint       String   @db.VarChar(200)
  requestHash    String   @map("request_hash") @db.VarChar(64)
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt      DateTime @map("expires_at") @db.Timestamptz

  user User @relation("UserIdempotencyKeys", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([key])
  @@index([userId])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ===== ÉPICA 07: Finanzas Operativas =====

model Receivable {
  id          String   @id @default(uuid()) @db.Uuid
  saleId      String   @unique @map("sale_id") @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  totalAmount Decimal  @map("total_amount") @db.Decimal(12, 2)
  amountPaid  Decimal  @default(0) @map("amount_paid") @db.Decimal(12, 2)
  balance     Decimal  @db.Decimal(12, 2)
  status      String   @default("PENDIENTE") @db.VarChar(20)
  dueDate     DateTime @map("due_date") @db.Date
  notes       String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
