enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
  COST
  ORDER_DEBTOR
  ORDER_CREDITOR
}

enum AccountingPurpose {
  CASH
  BANK
  CUSTOMERS
  SUPPLIERS
  INVENTORY
  SALES_TAXED
  SALES_EXCLUDED
  COST_OF_SALES
  VAT_OUTPUT
  VAT_INPUT
  VAT_INPUT_COMMON
  VAT_NON_DEDUCTIBLE
  SIMPLE_TAX_ADVANCE
  SALES_RETURNS
  SALES_DISCOUNTS
  CAPITAL
  CURRENT_YEAR_RESULT
}

enum AccountingMappingStatus {
  PENDING_MAPPING
  ACTIVE
  INACTIVE
}

model Account {
  id             String      @id @default(uuid()) @db.Uuid
  code           String      @unique @db.VarChar(32)
  name           String      @db.VarChar(255)
  type           AccountType
  parentId       String?     @map("parent_id") @db.Uuid
  level          Int
  allowsMovement Boolean     @default(false) @map("allows_movement")
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  parent   Account?                   @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children Account[]                  @relation("AccountHierarchy")
  mappings CompanyAccountingMapping[]
  journalEntryLines JournalEntryLine[]
  expenseCategories ExpenseCategory[]

  @@index([parentId])
  @@index([name])
  @@index([type, isActive])
  @@map("accounts")
}

model CompanyAccountingMapping {
  id            String                  @id @default(uuid()) @db.Uuid
  purpose       AccountingPurpose
  accountId     String?                 @map("account_id") @db.Uuid
  status        AccountingMappingStatus @default(PENDING_MAPPING)
  effectiveFrom DateTime                @default(now()) @map("effective_from") @db.Date
  effectiveTo   DateTime?               @map("effective_to") @db.Date
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime                @updatedAt @map("updated_at") @db.Timestamptz
  updatedById   String?                 @map("updated_by_id") @db.Uuid

  account   Account? @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  updatedBy User?    @relation("AccountingMappingsUpdated", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([accountId])
  @@index([updatedById])
  @@index([purpose, status, effectiveFrom])
  @@map("company_accounting_mappings")
}


enum JournalEntryStatus {
  DRAFT
  POSTED
}

model JournalEntry {
  id             String             @id @default(uuid()) @db.Uuid
  entryDate      DateTime           @map("entry_date") @db.Date
  description    String             @db.VarChar(500)
  sourceType     String             @map("source_type") @db.VarChar(64)
  sourceId       String             @map("source_id") @db.VarChar(128)
  status         JournalEntryStatus @default(DRAFT)
  createdById    String?            @map("created_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  postedAt       DateTime?          @map("posted_at") @db.Timestamptz
