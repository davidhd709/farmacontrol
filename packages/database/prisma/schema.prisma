  debit          Decimal      @db.Decimal(20, 2)
  credit         Decimal      @db.Decimal(20, 2)

  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([journalEntryId, position])
  @@index([accountId])
  @@map("journal_entry_lines")
}

enum FiscalPeriodStatus {
  OPEN
  CLOSED
}

model FiscalPeriod {
  id             String             @id @default(uuid()) @db.Uuid
  year           Int
  month          Int
  name           String             @db.VarChar(50)
  startDate      DateTime           @map("start_date") @db.Date
  endDate        DateTime           @map("end_date") @db.Date
  status         FiscalPeriodStatus @default(OPEN)
  closedAt       DateTime?          @map("closed_at") @db.Timestamptz
  closedById     String?            @map("closed_by_id") @db.Uuid
  reopenedAt     DateTime?          @map("reopened_at") @db.Timestamptz
