  supplierId      String          @map("supplier_id") @db.Uuid
  reason          String          @db.VarChar(500)
  subtotal        Decimal         @db.Decimal(12, 2)
  taxTotal        Decimal         @default(0) @map("tax_total") @db.Decimal(12, 2)
  total           Decimal         @db.Decimal(12, 2)
  createdById     String          @map("created_by_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  purchase        Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supplier        Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByUser   User            @relation("DebitNotesCreated", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lines           DebitNoteLine[]

  @@index([purchaseId])
  @@index([supplierId])
  @@index([debitNoteNumber])
  @@index([createdAt])
  @@map("debit_notes")
}

model DebitNoteLine {
  id                 String       @id @default(uuid()) @db.Uuid
  debitNoteId        String       @map("debit_note_id") @db.Uuid
  purchaseLineId     String       @map("purchase_line_id") @db.Uuid
  productId          String       @map("product_id") @db.Uuid
  lotId              String       @map("lot_id") @db.Uuid
  quantityCommercial Decimal      @map("quantity_commercial") @db.Decimal(12, 4)
  quantityBaseUnits  Int          @map("quantity_base_units")
  unitCost           Decimal      @map("unit_cost") @db.Decimal(12, 2)
  subtotal           Decimal      @db.Decimal(12, 2)
  taxRate            Decimal      @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount          Decimal      @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total              Decimal      @db.Decimal(12, 2)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz

  debitNote          DebitNote    @relation(fields: [debitNoteId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  purchaseLine       PurchaseLine @relation(fields: [purchaseLineId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  product            Product      @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lot                InventoryLot @relation(fields: [lotId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([debitNoteId])
  @@index([purchaseLineId])
  @@index([productId])
  @@index([lotId])
  @@map("debit_note_lines")
}

model ThirdParty {
  id                String    @id @default(uuid()) @db.Uuid
  personType        String    @default("NATURAL") @map("person_type") @db.VarChar(20)
  documentType      String    @default("CC") @map("document_type") @db.VarChar(20)
  documentNumber    String    @unique @map("document_number") @db.VarChar(50)
  verificationDigit String?   @map("verification_digit") @db.VarChar(2)
  name              String    @db.VarChar(200)
  tradeName         String?   @map("trade_name") @db.VarChar(200)
  contactName       String?   @map("contact_name") @db.VarChar(100)
  phone             String?   @db.VarChar(50)
  email             String?   @db.VarChar(100)
  address           String?   @db.VarChar(255)
  city              String?   @db.VarChar(100)
  department        String?   @db.VarChar(100)
  taxRegime         String?   @default("NO_RESPONSABLE_IVA") @map("tax_regime") @db.VarChar(50)
  isCustomer        Boolean   @default(false) @map("is_customer")
  isSupplier        Boolean   @default(false) @map("is_supplier")
  isEmployee        Boolean   @default(false) @map("is_employee")
  isOther           Boolean   @default(false) @map("is_other")
  isActive          Boolean   @default(true) @map("is_active")
  notes             String?   @db.VarChar(500)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  customerId        String?   @unique @map("customer_id") @db.Uuid
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  supplierId        String?   @unique @map("supplier_id") @db.Uuid
  supplier          Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([documentNumber])
  @@index([name])
  @@index([isCustomer])
  @@index([isSupplier])
  @@index([isEmployee])
  @@index([isActive])
  @@map("third_parties")
}


